{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev:web"
      ],
      "port": 3000
    },
    {
      "name": "admin",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev:admin"
      ],
      "port": 3001
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@lww/web",
        "exec",
        "next",
        "start",
        "--port",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "admin-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@lww/admin",
        "exec",
        "next",
        "start",
        "--port",
        "3101"
      ],
      "port": 3101
    }
  ]
}
