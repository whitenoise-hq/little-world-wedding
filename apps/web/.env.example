# apps/web/.env.local 로 복사해서 채운다. 이 파일(.env.example)에는 실제 값을 넣지 않는다.

# Supabase 프로젝트 URL (Project Settings → API Keys)
SUPABASE_URL=
# web 전용 secret 키. 서버에서만 쓴다 (브라우저로 나가지 않음)
SUPABASE_SECRET_KEY=

# 방명록 연속 작성 제한에 쓰는 IP 해시 소금. 아무 긴 무작위 문자열
IP_HASH_SALT=
# 매일 깨우기 헬스체크 보호 토큰. Vercel Cron이 Authorization: Bearer 로 보낸다
CRON_SECRET=
# 어드민에서 저장하면 하객 페이지 캐시를 갱신할 때 쓰는 토큰 (admin과 같은 값)
REVALIDATE_TOKEN=
