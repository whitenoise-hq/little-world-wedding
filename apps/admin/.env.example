# apps/admin/.env.local 로 복사해서 채운다. 이 파일(.env.example)에는 실제 값을 넣지 않는다.

# Supabase 프로젝트 URL과 publishable 키 (로그인에 씀, 브라우저에 노출돼도 되는 키)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# admin 전용 secret 키. 서버에서만 쓴다
SUPABASE_SECRET_KEY=

# 하객용 청첩장 주소 (주소 복사·하객 화면 열기)
NEXT_PUBLIC_WEB_URL=http://localhost:3000
# 저장 시 하객 페이지 캐시 갱신용 토큰 (web과 같은 값)
REVALIDATE_TOKEN=

# 카카오 REST API 키. 예식장 주소로 좌표를 찾을 때 서버에서만 쓴다 (카카오 디벨로퍼스 → 앱 → 플랫폼 키)
KAKAO_REST_API_KEY=
